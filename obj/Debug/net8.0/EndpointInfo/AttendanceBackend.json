      "get": {
        "tags": [
          "Zkteco"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Zkteco/get-all-logs": {
      "get": {
        "tags": [
          "Zkteco"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Zkteco/get-all-reasons": {
      "get": {
        "tags": [
          "Zkteco"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Zkteco/accept-reason": {
      "post": {
        "tags": [
          "Zkteco"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptReasonDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptReasonDto"
