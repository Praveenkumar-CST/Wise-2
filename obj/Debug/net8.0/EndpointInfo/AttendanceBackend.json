        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LowHoursReasonDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LowHoursReasonDto"
